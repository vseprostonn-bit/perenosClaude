# Скопируй в .env и заполни. .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Прод: postgresql+asyncpg://user:pass@localhost:5432/obraz
# Дев без Postgres: sqlite+aiosqlite:///./obraz.db
DATABASE_URL=sqlite+aiosqlite:///./obraz.db

# Сколько образов бесплатно до пейвола
FREE_LIMIT=5

# TG id владельца для служебных уведомлений
ADMIN_TG_ID=

# --- Оплата (фаза D) ---
# Базовый URL сайта: бот строит ссылки на пейвол от него
PUBLIC_BASE_URL=https://getobraz.ru
# Секрет для подписи pay-токенов: любые 32+ случайных символа
SECRET_KEY=
# Кабинет Robokassa -> Мои магазины -> технические настройки
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# 1 = тестовые платежи (деньги не списываются), 0 = боевые
ROBOKASSA_TEST_MODE=1
